+// Whether the client whose session a handler serves may see and attach to
+// `host`. A remote debugging client, and every session it opens, sees only
+// the targets the embedder exposes to remote debugging.
+bool ExposesTarget(DevToolsAgentHostClient* client, DevToolsAgentHost* host) {
+  DevToolsManagerDelegate* delegate =
+      DevToolsManager::GetInstance()->delegate();
+  return !delegate ||
+         client->GetTypeForMetrics() != kRemoteDebuggerClientType ||
+         delegate->AllowRemoteDebuggingTarget(host);
+}
 
