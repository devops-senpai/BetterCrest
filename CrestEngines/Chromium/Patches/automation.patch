+// The profile DevTools browses in by default. Arma's automation uses the
+// profile the person chose, never whichever profile Chromium used last.
+Profile* DefaultProfile() {
+#if BUILDFLAG(IS_MAC)
+  if (crest::automation::IsScoped()) {
+    return crest::automation::DefaultProfile();
+  }
+#endif
+  return ProfileManager::GetLastUsedProfile()->GetOriginalProfile();
+}
+
+// The profile a browser context DevTools creates derives from.
+Profile* SourceProfile() {
+#if BUILDFLAG(IS_MAC)
+  if (crest::automation::IsScoped()) {
+    return crest::automation::SourceProfile();
+  }
+#endif
+  return ProfileManager::GetLastUsedProfile()->GetOriginalProfile();
+}
